{
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=Platera;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Database": { "MigrateOnStartup": true },
  "Jwt": { "Issuer": "Platera", "Audience": "Platera.Web", "AccessTokenMinutes": 15, "RefreshTokenDays": 14 },
